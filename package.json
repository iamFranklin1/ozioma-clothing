{
    "name": "ozioma-clothing-server",
    "version": "1.0.0",
    "engines": {
    "node": "22.16.0",
    "npm": "11.6.2"
    },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.0",
    "express": "^5.2.1",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.14"
  },
  "scripts": {
